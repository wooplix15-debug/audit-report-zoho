# Groq API Configuration (Required for diagnostic LLM analysis)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Zoho OAuth Credentials (Optional - can also be provided directly via the UI intake form)
ZOHO_CLIENT_ID=1000.YOUR_CLIENT_ID
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=1000.your_refresh_token
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
